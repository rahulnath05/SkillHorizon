{
  "SkillHorizon": {
    "ZoneId": "local",
    "DomainConnectionString": "Host=localhost;Port=5432;Database=skillhorizon_domain;Username=skillhorizon;Password=skillhorizon",
    "Redis": "localhost:6379",
    "ControlRegistryUrl": "http://localhost:8082",
    "FanoutReference": true,
    "ReceiveReference": false,
    "RegistryKeySecretName": "registry-key",
    "Secrets": {
      "registry-key": "local-registry-key"
    },
    "EnableConsoleExporter": true,
    "MigrateOnStartup": true,
    "PublishOutbox": true,
    "ProjectPracticeOnStartup": true,
    "PracticeProjectionIntervalSeconds": 20,
    "ProjectTeamOnStartup": true,
    "TeamProjectionIntervalSeconds": 20
  }
}
