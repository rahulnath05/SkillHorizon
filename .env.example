# Local defaults for docker compose and dotnet run.
# Copy to .env only if you need to override them. Do not commit .env.

SKILLHORIZON_SECRET_LOCAL_SIGNING_KEY=local-signing-key-must-be-at-least-32b
SKILLHORIZON_SECRET_REGISTRY_KEY=local-registry-key

# Zone process
# SkillHorizon__ZoneId=local
# SkillHorizon__DomainConnectionString=Host=localhost;Port=5432;Database=skillhorizon_domain;Username=skillhorizon;Password=skillhorizon
# SkillHorizon__Redis=localhost:6379
# SkillHorizon__ControlRegistryUrl=http://localhost:8082
# SkillHorizon__ApiUrl=http://localhost:8081
# SkillHorizon__DevIdentities=person-multi|LE-LOCAL|person-multi;person-single|LE-LOCAL|person-single;person-unmapped|LE-OTHER|person-unmapped;person-nogrant|LE-LOCAL|person-nogrant;person-ld|LE-LOCAL|person-ld

# OpenID Connect, when a corporate issuer is configured. Leave the authority empty to use the local adapter.
# SkillHorizon__Oidc__Authority=
# SkillHorizon__Oidc__ClientId=
# SkillHorizon__Oidc__Audience=
# SKILLHORIZON_SECRET_OIDC_CLIENT_SECRET=
