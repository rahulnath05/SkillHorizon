# First wave. The authoring zone is the installation in compose.yaml.
# local  LE-LOCAL  authoring, already provisioned
# north  LE-NORTH  residency
# south  LE-SOUTH  residency
# LE-OTHER stays unmapped and is never written into one of these zones.
NORTH_ZONE_ID=north
NORTH_LEGAL_ENTITY=LE-NORTH
SOUTH_ZONE_ID=south
SOUTH_LEGAL_ENTITY=LE-SOUTH
